# ==============================================================================
# Dentora Dental Clinic - Environment Variables Template
#
# IMPORTANT SECURITY NOTES:
# 1. Variables prefixed with "VITE_" are embedded into the client-side JavaScript bundle
#    during the build process and are publicly inspectable by anyone visiting the site.
# 2. NEVER put private API secrets, database credentials, or secret keys here.
# 3. Secret keys (e.g. EHR database passwords, Stripe secret keys, SMTP credentials)
#    MUST reside exclusively on an isolated backend or API service.
# 4. Copy this file to `.env` or `.env.local` for local development overrides:
#    cp .env.example .env.local
# ==============================================================================

# Production Site URL (Used for Canonical URLs, Open Graph, Sitemap & Schema.org)
VITE_SITE_URL=https://dentora-clinic.example.com

# Clinic Branding Information (Optional overrides)
VITE_CLINIC_NAME=Dentora
VITE_CLINIC_LEGAL_NAME=Dentora Dental Care LLC
VITE_CLINIC_PHONE=+1 (800) 456-7890
VITE_CLINIC_PHONE_CLEAN=+18004567890
VITE_CLINIC_EMERGENCY_PHONE=+1 (800) 911-DENT
VITE_CLINIC_EMERGENCY_CLEAN=+18009113368
VITE_CLINIC_EMAIL=concierge@dentoraclinic.com
VITE_CLINIC_LOGO_URL=https://dentora-clinic.example.com/logo.png

# Clinic Address
VITE_CLINIC_STREET=450 Lexington Avenue, Suite 1800
VITE_CLINIC_CITY=New York
VITE_CLINIC_STATE=NY
VITE_CLINIC_ZIP=10017

# Maps & Profiles
VITE_GOOGLE_MAPS_URL=https://maps.google.com/?q=450+Lexington+Ave+New+York+NY+10017
VITE_GOOGLE_BUSINESS_URL=https://business.google.com

# Social & SEO
VITE_TWITTER_HANDLE=@DentoraClinic
VITE_OG_IMAGE=https://images.unsplash.com/photo-1629909613654-28e377c37b09?auto=format&fit=crop&w=1200&q=80

# Backend API Endpoint (Optional - for future production EHR/appointment booking backend)
VITE_API_BASE_URL=
